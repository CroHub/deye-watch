# Copy to .env and fill in. / Скопіюй у .env і заповни.

# --- Required / обов'язково ---
# Solarman LSW-3 Wi-Fi logger: its LAN IP and the LOGGER serial number (sticker on the logger, not the inverter)
INVERTER_HOST=
INVERTER_SERIAL=

# --- Telegram (optional; without a token the bot runs log-only) ---
# Bot token from @BotFather
TELEGRAM_TOKEN=
# Owner's chat_id: service messages (startup, inverter link, new users) go only here
TELEGRAM_ADMIN=

# --- Optional (defaults shown) ---
# INVERTER_PORT=8899
# BATTERY_KWH=5.0  # usable battery capacity, kWh
# BATTERY_MIN_SOC=20  # autonomy is estimated down to this SOC, %
# BATTERY_LOW_SOC=25  # "battery running low" warning below this SOC, %
# BATTERY_LOW_SOC_RESET=30  # warn again only after recharging above this SOC, %
# TARIFF=4.32  # grid price per kWh (shown in UAH)
# TZ=Europe/Kyiv
# DATA_DIR=  # where users.json and state.json live (default: data/ next to the code)
